# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts
next-env.d.ts

# =========================
# AI / ML Subsystem Ignore Rules
# =========================

# Virtual environment
/ai/.venv/

# Dataset (raw images, splits, processed artifacts, external data, segmentations)
/ai/dataset/raw/
/ai/dataset/processed/
/ai/dataset/splits/
/ai/dataset/external_test/
/ai/dataset/segmentations/
/ai/dataset/synthetic_smoke_test/
/ai/dataset/HAM10000_metadata.csv

# Models & Checkpoints
/ai/models/*.pt
/ai/models/*.pth
/ai/models/synthetic_smoke_test/

# Results & Visualizations
/ai/results/

# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd
